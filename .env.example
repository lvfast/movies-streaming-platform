POSTGRES_DB=media_streaming
POSTGRES_USER=media_streaming
POSTGRES_PASSWORD=local-only-change-me
DATABASE_URL=jdbc:postgresql://postgres:5432/media_streaming
DATABASE_USERNAME=media_streaming
DATABASE_PASSWORD=local-only-change-me
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
PUBLIC_BASE_URL=http://localhost:8080
MEDIA_BASE_URL=http://localhost:8080/media
SECURE_COOKIE=false
REFRESH_COOKIE_NAME=refresh_token

# Production-only values. Keep real values outside Git.
GHCR_REPOSITORY=owner/media-streaming-platform
BACKEND_IMAGE_DIGEST=replace-with-64-hex-character-digest
FRONTEND_IMAGE_DIGEST=replace-with-64-hex-character-digest
JWT_PRIVATE_KEY_FILE=/absolute/path/to/jwt-private.pem
JWT_PUBLIC_KEY_FILE=/absolute/path/to/jwt-public.pem
