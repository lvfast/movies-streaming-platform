POSTGRES_DB=media_streaming
POSTGRES_USER=media_streaming
POSTGRES_PASSWORD=local-only-change-me
MEDIA_BASE_URL=
# The media gateway is a separate origin from the web app, so protected playback needs its exact
# origin twice: once in the frontend bundle (VITE_MEDIA_BASE_URL, a build argument) and once in the
# frontend CSP (MEDIA_ORIGIN, read at container start). Admin uploads PUT parts straight to
# presigned source-bucket URLs, so the CSP also names the browser-facing storage origin
# (MEDIA_STORAGE_ORIGIN, normally the same value as S3_BROWSER_ENDPOINT). Leave them empty for a
# same-origin stack.
MEDIA_ORIGIN=
VITE_MEDIA_BASE_URL=
MEDIA_STORAGE_ORIGIN=
SECURE_COOKIE=false
REFRESH_COOKIE_NAME=refresh_token
MEDIA_SOURCE_BUCKET=media-source
MEDIA_DELIVERY_BUCKET=media-delivery
MEDIA_WORKER_CREDENTIAL=worker-local-credential
WORKER_ID=worker-1
RABBITMQ_USERNAME=media
RABBITMQ_PASSWORD=media-local
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BROWSER_ENDPOINT=http://127.0.0.1:9000
S3_BROWSER_ACCESS_KEY=minioadmin
S3_BROWSER_SECRET_KEY=minioadmin
# Media tokens are signed with a dedicated RSA key pair, separate from the login-token keys.
# Both pairs must be mounted for the backend to start.
# MEDIA_JWT_PRIVATE_KEY=file:/run/secrets/media-private.pem
# MEDIA_JWT_PUBLIC_KEY=file:/run/secrets/media-public.pem
# MEDIA_SIGNING_KEY_ID=
# The public media JWK must be given to the media gateway (wrangler secret put JWT_PUBLIC_JWK).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
