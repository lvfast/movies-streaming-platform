worker_processes auto;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" request_time=$request_time';
    access_log /dev/stdout main;
    error_log /dev/stderr warn;

    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 30;
    client_max_body_size 1m;

    gzip on;
    gzip_min_length 1024;
    gzip_types application/javascript application/json application/vnd.apple.mpegurl image/svg+xml text/css text/plain;

    map $uri $cache_control {
        default "no-store";
        ~^/assets/ "public, max-age=31536000, immutable";
        ~^/media/ "public, max-age=60";
    }

    upstream backend_upstream {
        server backend:8080;
        keepalive 16;
    }

    # Managed playback loads HLS from the media gateway, and Admin uploads PUT parts straight to
    # presigned source-bucket URLs, so both are separate origins from the web app. The deployment
    # supplies the exact origins as MEDIA_ORIGIN and MEDIA_STORAGE_ORIGIN so connect-src names those
    # origins and nothing else; an unset value expands to nothing and keeps the strict same-origin
    # policy. The image's 05-render-nginx-config.sh entrypoint script substitutes this file before
    # Nginx starts.
    server {
        listen 8080;
        listen [::]:8080;
        root /usr/share/nginx/html;
        index index.html;

        set $media_origin "${MEDIA_ORIGIN}";
        set $storage_origin "${MEDIA_STORAGE_ORIGIN}";
        set $csp "default-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self' $media_origin $storage_origin; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'";

        add_header Content-Security-Policy $csp always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Cache-Control $cache_control always;

        location = /healthz {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        location = /api {
            return 308 /api/;
        }

        location /api/ {
            proxy_pass http://backend:8080;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Forwarded "";
            proxy_set_header X-Real-IP "";
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 3s;
            proxy_read_timeout 30s;
            proxy_send_timeout 30s;
        }

        location /media/ {
            alias /usr/share/nginx/media/;
        }

        location /assets/ {
            try_files $uri =404;
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
