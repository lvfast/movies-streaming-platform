{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lvfast.dev/contracts/media/command-v1.schema.json",
  "title": "Media processing command",
  "description": "A durable outbox command that notifies the worker a job is available. It carries only the job id; the worker claims source/output parameters from the authenticated backend endpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "type", "jobId", "occurredAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "format": "uuid" },
    "type": { "enum": ["transcode.requested.v1", "artwork.requested.v1"] },
    "jobId": { "type": "string", "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" }
  }
}
